# =============================================================================
# CI Review Agent — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Lines starting with # are comments. Empty lines are ignored.
# String values can be quoted or unquoted.
# =============================================================================

# -----------------------------------------------------------------------------
# CI Provider
# -----------------------------------------------------------------------------
# GitHub personal access token (repo scope)
GITHUB_TOKEN=

# Forgejo access token
FORGEJO_TOKEN=
FORGEJO_BASE_URL=https://forgejo.example.com

# -----------------------------------------------------------------------------
# LLM Provider
# -----------------------------------------------------------------------------
# Choose: openai | anthropic | gemini | ollama | azure_openai
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Google Gemini (AI Studio)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# -----------------------------------------------------------------------------
# MCP Messaging Server
# -----------------------------------------------------------------------------
# Path to the universal-messaging-mcp Go binary
MCP_SERVER_COMMAND=./universal-messaging-mcp

# Messaging platform: mattermost | slack | discord
MESSAGING_PLATFORM=mattermost

# Webhook URLs (set the one for your platform)
MATTERMOST_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

# -----------------------------------------------------------------------------
# Webhook Secrets (for signature verification)
# -----------------------------------------------------------------------------
# Set these to verify webhook payloads from your CI provider
FORGEJO_WEBHOOK_SECRET=
GITHUB_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Agent Behavior
# -----------------------------------------------------------------------------
# Maximum retry attempts before escalating to human
MAX_RETRY_ATTEMPTS=3

# Bot account username for your CI agent (e.g., "ci-review-bot")
# When set, the agent will ignore CI events triggered by this user,
# preventing infinite loops where the bot's own commits trigger new agent runs.
CI_BOT_USERNAME=CI Review Bot
CI_BOT_EMAIL=ci-bot@autofix.internal

# Git repository path (where patches are applied)
GIT_REPO_PATH=.

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
# Bind address (localhost only for security)
SERVER_HOST=127.0.0.1
SERVER_PORT=8000

# -----------------------------------------------------------------------------
# Authentication (HTTP-only cookie auth)
# -----------------------------------------------------------------------------
# Secret key for session signing (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
SECRET_KEY=

# Admin user (full access)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Viewer user (read-only dashboard access)
VIEWER_USERNAME=viewer
VIEWER_PASSWORD=viewer123
